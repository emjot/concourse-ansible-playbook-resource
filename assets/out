#!/usr/bin/env bash

set -e

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

eval $(ssh-agent) > /dev/null 2>&1
trap "kill $SSH_AGENT_PID" 0

$(dirname $0)/lib/commands/out.rb $1 <&0

# Concourse >= 8 rejects empty versions, and fails the put step on them as of
# 8.3. A playbook run has no inherent version, so (like the time resource)
# emit the run's timestamp as a unique version for each successful put.
printf '{"version":{"timestamp":"%s"}}' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&3
